{
  "name": "astro-cooklang",
  "version": "0.0.1-alpha2",
  "description": "Use Cooklang recipes within Astro",
  "homepage": "https://astro-cooklang.kauh.at/",
  "repository": "github:kauhat/astro-cooklang-integration",
  "author": "Jack Fletcher",
  "license": "MIT",
  "keywords": [
    "astro-integration",
    "astro-component",
    "cooklang"
  ],
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./dist/index.d.ts"
    },
    "./components": "./components/index.ts"
  },
  "files": [
    "components",
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "clean": "rimraf ./dist"
  },
  "dependencies": {
    "@cooklang/cooklang-ts": "^1.2.6"
  },
  "devDependencies": {
    "astro": "4.13.2",
    "gray-matter": "^4.0.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.20.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "astro": "^2.5.0 || ^3.0.0 || ^4.0.0"
  }
}
